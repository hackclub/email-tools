<% content_for :title, "Email Audit Logs" %>

<style>
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    line-height: 1.6;
  }
  h1 {
    color: #333;
    margin-bottom: 30px;
  }
  .nav {
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid #ddd;
  }
  .nav a {
    color: #007bff;
    text-decoration: none;
    margin-right: 20px;
    font-weight: 500;
  }
  .nav a:hover {
    text-decoration: underline;
  }
  .nav a.active {
    color: #333;
    font-weight: 600;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    padding: 12px;
    margin-bottom: 8px;
    background-color: #f5f5f5;
    border-radius: 4px;
    border-left: 3px solid #007bff;
  }
  li:hover {
    background-color: #e9ecef;
  }
  a {
    color: #007bff;
    text-decoration: none;
    font-weight: 500;
  }
  a:hover {
    text-decoration: underline;
  }
  .empty {
    color: #666;
    font-style: italic;
  }
  .search-form {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }
  .search-form input[type="text"] {
    flex: 1;
    max-width: 400px;
    padding: 8px 12px;
    font-size: 15px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }
  .search-form button {
    padding: 8px 16px;
    font-size: 15px;
    color: #fff;
    background-color: #007bff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }
  .search-form button:hover {
    background-color: #0069d9;
  }
  .search-form a.clear-search {
    align-self: center;
    font-size: 14px;
  }
  .result-count {
    color: #666;
    font-size: 14px;
    margin-bottom: 15px;
  }
  .pagination {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0;
  }
  .pagination .page-link {
    padding: 6px 14px;
    background-color: #f5f5f5;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-weight: 500;
  }
  .pagination .page-link:hover {
    background-color: #e9ecef;
    text-decoration: none;
  }
  .pagination .disabled {
    padding: 6px 14px;
    color: #aaa;
    background-color: #fafafa;
    border: 1px solid #eee;
    border-radius: 4px;
  }
  .pagination .page-info {
    color: #666;
    font-size: 14px;
  }
</style>

<div class="nav">
  <%= link_to "Email Audit Logs", admin_emails_path, class: (request.path == admin_emails_path ? "active" : "") %>
  <%= link_to "Sync Sources", admin_sync_sources_path, class: (request.path.start_with?("/admin/sync_sources") ? "active" : "") %>
  <%= link_to "Sidekiq", "/admin/sidekiq", class: (request.path.start_with?("/admin/sidekiq") ? "active" : "") %>
</div>

<h1>Email Audit Logs</h1>

<%= form_with url: admin_emails_path, method: :get, class: "search-form" do %>
  <input type="text" name="q" value="<%= @query %>" placeholder="Search emails..." autofocus>
  <button type="submit">Search</button>
  <% if @query.present? %>
    <%= link_to "Clear", admin_emails_path, class: "clear-search" %>
  <% end %>
<% end %>

<p class="result-count">
  <%= number_with_delimiter(@total_count) %> <%= "email".pluralize(@total_count) %><% if @query.present? %> matching "<%= @query %>"<% end %>
</p>

<% pagination_needed = @total_pages > 1 %>
<% pagination = capture do %>
  <div class="pagination">
    <% if @page > 1 %>
      <%= link_to "← Previous", admin_emails_path(page: @page - 1, q: @query.presence), class: "page-link" %>
    <% else %>
      <span class="disabled">← Previous</span>
    <% end %>
    <span class="page-info">Page <%= @page %> of <%= number_with_delimiter(@total_pages) %></span>
    <% if @page < @total_pages %>
      <%= link_to "Next →", admin_emails_path(page: @page + 1, q: @query.presence), class: "page-link" %>
    <% else %>
      <span class="disabled">Next →</span>
    <% end %>
  </div>
<% end %>

<%= pagination if pagination_needed %>

<% if @emails.any? %>
  <ul>
    <% @emails.each do |email| %>
      <li>
        <%= link_to email, admin_email_audit_log_path(email) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="empty">
    <% if @query.present? %>
      No emails found matching "<%= @query %>".
    <% else %>
      No emails with audit logs found.
    <% end %>
  </p>
<% end %>

<%= pagination if pagination_needed %>

